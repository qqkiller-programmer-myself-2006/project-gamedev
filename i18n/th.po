msgstr "%s ออกจากห้องแล้ว ช่องของเขาจะถูกเอไอควบคุม"

#: src/client/match/match_screen.gd:506
msgid "%s ran out of time and defends."
msgstr "%s หมดเวลาและป้องกัน."

#: src/client/match/match_screen.gd:467
