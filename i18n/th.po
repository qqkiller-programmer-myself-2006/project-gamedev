#: src/client/match/vote_panel.gd:107
msgid "  Votes: %d%s"
msgstr "  คะแนนโหวต: %d%s"

#: src/client/match/match_screen.gd:526
msgid " (shielding %s)"
msgstr " (มี %s คุ้มกัน)"

#: src/client/match/match_screen.gd:528
msgid " - down"
msgstr " - ล้มลง"

#: src/client/match/match_screen.gd:449
msgid " It was a tie, broken at random."
msgstr " คะแนนเสมอกัน จึงสุ่มเลือก"

#: src/client/match/match_screen.gd:447
msgid " Nobody voted, so it was picked at random."
msgstr " ไม่มีใครโหวต จึงสุ่มเลือก"

#: src/client/match/vote_panel.gd:233
msgid " Waiting: %s."
msgstr " กำลังรอ: %s"

#: src/client/match/match_screen.gd:498
msgid " and falls"
msgstr " และล้มลง"

#: src/client/match/match_screen.gd:522
msgid " critical!"
msgstr " คริติคอล!"

#: src/client/match/match_screen.gd:524
msgid " weak spot!"
msgstr " จุดอ่อน!"

#: content/forest.json:story.events.ranger_hut.choices[0].outcome.text
msgid "\"He asked about the Guardian of the Forest. Said he had to get past it, whatever it cost. I never saw him come back.\""
msgstr "\"เขาถามถึงผู้พิทักษ์แห่งป่า บอกว่าต้องผ่านมันไปให้ได้ไม่ว่าต้องแลกด้วยอะไร แต่ข้าไม่เคยเห็นเขากลับมาอีก\""

#: content/forest.json:encounters.merchant.greeting
msgid "\"Herbs, tonics, a little fire in a jar. Coin first, friends.\""
msgstr "\"สมุนไพร ยาบำรุง ไฟใส่ขวดอีกนิดหน่อย จ่ายเงินก่อนนะสหาย\""

#: content/forest.json:classes.archer.challenge.fail
msgid "\"Too slow. The forest does not wait for anyone.\""
msgstr "\"ช้าเกินไป ป่าไม่เคยรอใคร\""

#: content/forest.json:story.events.ranger_hut.choices[1].outcome.text
msgid "\"You were carrying his journal, lad, and shaking. You kept saying: it asks for a life. Then you slept for three days.\""
msgstr "\"เจ้าหอบสมุดบันทึกของเขามา ตัวสั่นเทา พูดซ้ำอยู่ว่า มันเรียกร้องชีวิตหนึ่ง แล้วเจ้าก็หลับไปสามวัน\""

#: src/client/ui/tr.gd:formatted_fallback src/client/ui/ui_text.gd:LABELS.gems
