msgid "%s recovers %d HP (now %d)."
msgstr "%s ฟื้นพลังชีวิต %d หน่วย (ขณะนี้ %d)"

#: src/client/match/match_screen.gd:497
msgid "%s takes %d from %s%s."
msgstr "%s ได้รับความเสียหาย %d จาก%s%s"

#: src/client/match/match_screen.gd:529
msgid "%s takes %d%s"
msgstr "%s ได้รับความเสียหาย %d%s"

